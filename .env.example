# ============================================================================
# VM Robotics Document Tracker — environment variables
# Copy this file to ".env" for local dev and fill in real values.
# In production, set these in the Vercel project settings (NOT in the repo).
# ============================================================================

# --- CLIENT (exposed to the browser; safe to ship) ---------------------------
# Vite only exposes vars prefixed with VITE_ to client code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# --- SERVER ONLY (Vercel API routes; NEVER prefix with VITE_, never ship) -----
# These must stay out of the browser bundle (brief §2).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# Note: payments are imported in-app via CSV/TSV paste — no Google account or
# Google Cloud project needed. See /payments → Import CSV.
