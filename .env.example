# ============================================================================
# VM Robotics Document Tracker — environment variables
# Copy this file to ".env" for local dev and fill in real values.
# In production, set these in the Vercel project settings (NOT in the repo).
# ============================================================================

# --- CLIENT (exposed to the browser; safe to ship) ---------------------------
# Vite only exposes vars prefixed with VITE_ to client code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# --- SERVER ONLY (Vercel API routes; NEVER prefix with VITE_, never ship) -----
# These must stay out of the browser bundle (brief §2).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-API-KEY

# --- Google Sheets sync (api/sync-payments.ts) ------------------------------
# One-time owner setup:
#  1. GCP project → enable "Google Sheets API"
#  2. Create a Service Account, download JSON key
#  3. Share the CashFlow_9 sheet with the service-account email (Viewer)
#  4. Paste the four vars below into Vercel
# Tip: in Vercel UI, paste the private key as-is (with real newlines). If your
# secrets pipeline only accepts one-liners, replace newlines with literal \n —
# the route un-escapes them.
GOOGLE_SERVICE_ACCOUNT_EMAIL=cashflow-sync@YOUR-PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CASHFLOW_SHEET_ID=YOUR-SPREADSHEET-ID-FROM-URL
# Optional — defaults to "CashFlow_9!A2:L" if unset.
CASHFLOW_SHEET_RANGE=CashFlow_9!A2:L
